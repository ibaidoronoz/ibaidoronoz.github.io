---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page is not in the catalogue.">
  <section class="wrap not-found">
    <span class="kicker">404</span>
    <h1>This page is not in the catalogue.</h1>
    <p class="lead">The link may be old. Everything else is still here.</p>
    <div class="cta">
      <a class="btn primary" href="/">Back home</a>
      <a class="btn" href="/work">All work</a>
    </div>
  </section>
</Base>
