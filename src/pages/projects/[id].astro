---
import { getCollection } from 'astro:content';
import Project from '../../views/Project.astro';
import { assertCaseStudies } from '../../lib/projects';

export async function getStaticPaths() {
  await assertCaseStudies('en');
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({ params: { id: study.data.project }, props: { study } }));
}

const { study } = Astro.props;
---

<Project lang="en" study={study} />
