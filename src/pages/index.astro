---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chips from '../components/Chips.astro';
import AiRole from '../components/AiRole.astro';
import HeroTimeline from '../components/HeroTimeline.astro';
import MethodPipeline from '../components/MethodPipeline.astro';
import ModelPrinciples from '../components/ModelPrinciples.astro';
import ProjectPoster from '../components/ProjectPoster.astro';
import ProjectLogo from '../components/ProjectLogo.astro';
import { site } from '../data/site';
import { AREAS, STATUS } from '../data/taxonomy';
import { projectsByTier, assertCaseStudies } from '../lib/projects';

await assertCaseStudies();
const featured = await projectsByTier('featured');
const selected = await projectsByTier('selected');
const archive = await projectsByTier('archive');
const all = [...featured, ...selected, ...archive];
const withPage = new Set((await getCollection('caseStudies')).map((s) => s.data.project));

// Only offer filters for areas that actually have projects below the fold.
const usedAreas = new Set([...selected, ...archive].flatMap((p) => p.data.areas));
const filters = Object.entries(AREAS).filter(([key]) => usedAreas.has(key as keyof typeof AREAS));

// Technologies that at least one project declares, so the map only links where it can.
const techSet = new Set(all.flatMap((p) => p.data.stack).map((t) => t.toLowerCase()));

// "2,400+" -> { count: 2400, suffix: "+" } for the animated counters.
const parseStat = (v: string) => {
  const m = v.match(/^([\d,]+)(.*)$/);
  return m ? { count: Number(m[1].replace(/,/g, '')), suffix: m[2] } : null;
};
const { links } = site;
---

<Base>
  <section class="hero wrap">
    <div class="hero-copy">
      <span class="pill reveal"><span class="dot"></span>{site.pill}</span>
      <h1 class="reveal" style="--d:.05s">
        <span class="role">{site.role}</span>
        <span class="grad-text">{site.focus}</span>
      </h1>
      <p class="tagline reveal" style="--d:.1s">{site.tagline}</p>
      <div class="cta reveal" style="--d:.2s">
        <a class="btn primary" href="#work">See the work ↓</a>
        <a class="btn" href={links.linkedin}>LinkedIn ↗</a>
        <a class="btn" href={links.github}>GitHub ↗</a>
      </div>
    </div>
    <HeroTimeline />
  </section>

  <div class="wrap">
    <div class="stats">
      {site.stats.map((s, i) => {
        const parsed = parseStat(s.value);
        return (
          <div class="stat reveal" style={`--d:${i * 0.07}s`}>
            <b
              data-count={parsed?.count}
              data-suffix={parsed?.suffix}
            >{s.value}</b>
            <span>{s.label}</span>
          </div>
        );
      })}
    </div>
  </div>

  <section id="work" class="section wrap">
    <div class="section-head reveal">
      <div>
        <span class="kicker">Featured work</span>
        <h2>Systems, not demos.</h2>
      </div>
      <div class="section-aside">
        <span class="eyebrow">Source is private · walkthroughs on request</span>
        <a class="section-link" href="/work">All {all.length} projects →</a>
      </div>
    </div>
    <div class="featured">
      {featured.map((p, i) => (
        <a class="feature reveal" href={`/projects/${p.id}/`} style={`--accent:${p.data.accent};--d:${(i % 2) * 0.08}s`}>
          <ProjectPoster id={p.id} name={p.data.name} logo={p.data.logo} accent={p.data.accent} fact={p.data.fact} />
          <div class="feature-body">
            <span class="area">{p.data.areas.map((a) => AREAS[a]).join(' · ')}</span>
            <h3>{p.data.name}</h3>
            <p>{p.data.oneLiner}</p>
            {p.data.components.length > 0 && (
              <ul class="components">
                {p.data.components.map((c) => (
                  <li>
                    <span class="comp-name">{c.name}</span>
                    <span class="comp-role">{c.role}</span>
                  </li>
                ))}
              </ul>
            )}
            <ul>{p.data.highlights.slice(0, 2).map((h) => <li>{h}</li>)}</ul>
            <span class="more">Read the case study</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="method" class="section wrap">
    <div class="section-head reveal">
      <div>
        <span class="kicker">How I build with AI</span>
        <h2>Agents write code.<br />Engineers own outcomes.</h2>
      </div>
    </div>
    <MethodPipeline />

    <div class="model-strip reveal">
      <span class="eyebrow">The model layer</span>
      <ModelPrinciples />
    </div>
  </section>

  <section id="projects" class="section wrap">
    <div class="section-head reveal">
      <div>
        <span class="kicker">More projects</span>
        <h2>The rest of the workshop.</h2>
      </div>
      <div class="filters" role="group" aria-label="Filter projects by area">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {filters.map(([key, label]) => (
          <button type="button" data-filter={key} aria-pressed="false">{label}</button>
        ))}
      </div>
    </div>

    <div class="selected" data-group>
      {selected.map((p, i) => (
        <details class="card reveal" data-areas={p.data.areas.join(' ')} style={`--accent:${p.data.accent};--d:${(i % 3) * 0.06}s`}>
          <img class="card-art" src={`/art/${p.id}.svg`} alt="" aria-hidden="true" width="400" height="250" loading="lazy" />
          <summary>
            <span class="bar"></span>
            <div class="card-head">
              <ProjectLogo name={p.data.name} logo={p.data.logo} accent={p.data.accent} size="md" />
              <div>
                <h3>{p.data.name}</h3>
                <span class="status" data-status={p.data.status}>{STATUS[p.data.status]}</span>
              </div>
            </div>
            <p>{p.data.oneLiner}</p>
            <span class="toggle">Details</span>
          </summary>
          <ul>{p.data.highlights.map((h) => <li>{h}</li>)}</ul>
          <Chips items={p.data.stack} />
          {p.data.underTheHood.length > 0 && (
            <div class="under">
              <span class="eyebrow">Under the hood</span>
              <ul>{p.data.underTheHood.map((u) => <li>{u}</li>)}</ul>
            </div>
          )}
          <AiRole role={p.data.aiRole} />
          {withPage.has(p.id) && (
            <a class="card-link" href={`/projects/${p.id}/`}>Read the short version →</a>
          )}
        </details>
      ))}
    </div>

    <div data-group class="reveal">
      <p class="eyebrow subhead">Archive & lab</p>
      <ul class="archive">
        {archive.map((p) => (
          <li data-areas={p.data.areas.join(' ')}>
            <a class="archive-row" href={`/projects/${p.id}/`}>
              <span class="name"><ProjectLogo name={p.data.name} logo={p.data.logo} accent={p.data.accent} size="sm" />{p.data.name}</span>
              <span class="desc">{p.data.oneLiner}</span>
              <span class="stack">{p.data.stack.join(' · ')}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="wrap stack-block reveal">
    <p class="stack-intro">
      <span class="eyebrow">Stack</span>
      <span>Click a technology to see the projects that use it.</span>
    </p>
    <div class="stack-map">
      {site.stackGroups.map((group) => (
        <div class="stack-group">
          <span class="stack-label">{group.label}</span>
          <ul>
            {group.items.map((item) => (
              <li>
                {techSet.has(item.toLowerCase())
                  ? <a href={`/work?tech=${encodeURIComponent(item)}`}>{item}</a>
                  : <span>{item}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <section id="experience" class="section wrap">
    <div class="section-head reveal">
      <div>
        <span class="kicker">Experience</span>
        <h2>10+ years shipping backend.</h2>
      </div>
    </div>
    <div class="timeline">
      {site.experience.map((job) => {
        const summary = job.engagements[0]?.points[0] ?? '';
        return (
          <div class="job reveal">
            <div class="job-when">
              <h3>{job.company}</h3>
              <span class="eyebrow">{job.period}</span>
            </div>
            <div class="job-body">
              <strong>{job.role}</strong>
              {summary && <p class="job-summary">{summary}</p>}
              <details class="job-more">
                <summary>Clients and detail</summary>
                {job.engagements.map((e) => (
                  <div class="engagement">
                    {e.client && (
                      <p class="client">
                        {e.client}
                        {e.period && <span class="eyebrow"> · {e.period}</span>}
                      </p>
                    )}
                    <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
                  </div>
                ))}
              </details>
            </div>
          </div>
        );
      })}
      <div class="job reveal">
        <div>
          <h3>Education</h3>
        </div>
        <div>
          {site.education.map((ed) => (
            <p class="client">
              {ed.title}
              <span class="eyebrow"> · {ed.place} · {ed.period}</span>
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <a class="all-work" href="/work">
      <div>
        <span class="kicker">All work</span>
        <h2>19 projects, one way of working.</h2>
      </div>
      <span class="btn primary">See every project →</span>
    </a>
    <p class="closing">
      Prefer to talk? <a href={links.linkedin}>Find me on LinkedIn ↗</a>
    </p>
  </section>
</Base>

<script>
  const initHome = () => {
    const section = document.querySelector<HTMLElement>('#projects');
    if (!section || section.dataset.ready) return;
    section.dataset.ready = '1';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Project filters. Without JS every project stays visible.
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('#projects [data-areas]');
    const groups = document.querySelectorAll<HTMLElement>('#projects [data-group]');
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const item of items) {
          const areas = (item.dataset.areas ?? '').split(' ');
          item.hidden = filter !== 'all' && !areas.includes(filter);
        }
        for (const group of groups) {
          group.hidden = group.querySelector('[data-areas]:not([hidden])') === null;
        }
      });
    }

    // Animated counters, once, when the stats scroll into view.
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix ?? '';
      const start = performance.now();
      const duration = 1400;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.round(target * eased).toLocaleString('en') + suffix;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if (!reduced && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            run(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      });
      counters.forEach((counter) => io.observe(counter));
    }
  };

  document.addEventListener('astro:page-load', initHome);
  initHome();
</script>
