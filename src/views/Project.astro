---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chips from '../components/Chips.astro';
import AiRole from '../components/AiRole.astro';
import Flow from '../components/Flow.astro';
import Diagram from '../components/Diagram.astro';
import ProjectLogo from '../components/ProjectLogo.astro';
import ProjectPoster from '../components/ProjectPoster.astro';
import DecisionCards from '../components/DecisionCards.astro';
import StudyBlocks from '../components/StudyBlocks.astro';
import CaseRail from '../components/CaseRail.astro';
import { ui } from '../data/i18n/ui';
import { allProjects, projectById, projectsWithPage } from '../lib/projects';
import { path } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

type Study = CollectionEntry<'caseStudies'> | CollectionEntry<'caseStudiesEs'>;

interface Props {
  lang: Lang;
  study: Study;
}

const { lang, study } = Astro.props;
const copy = ui[lang];
const project = await projectById(study.data.project, lang);
if (!project) throw new Error(`Unknown project: ${study.data.project}`);

const { Content, headings } = await render(study as CollectionEntry<'caseStudies'>);
const p = project.data;
const isShort = study.data.format === 'short';
const ogImage = lang === 'es' ? `/og/es/${project.id}.png` : `/og/${project.id}.png`;

const ordered = await projectsWithPage(lang);
const index = ordered.findIndex((entry) => entry.id === project.id);
const next = ordered[(index + 1) % ordered.length];

const related = (await allProjects(lang))
  .filter((entry) => entry.id !== project.id)
  .map((entry) => ({
    entry,
    shared: entry.data.areas.filter((area) => p.areas.includes(area)).length,
  }))
  .filter((item) => item.shared > 0)
  .sort((a, b) => b.shared - a.shared || a.entry.data.order - b.entry.data.order)
  .slice(0, 2);
---

<Base lang={lang} title={p.name} description={p.oneLiner} image={ogImage}>
  <div class="read-progress" data-progress aria-hidden="true"></div>
  <div class="wrap" style={`--accent:${p.accent}`}>
    <header class="cs-hero">
      <a class="back" href={path(lang, '/work')}>{copy.project.back}</a>
      <span class="name reveal">
        <span transition:name={`logo-${project.id}`}>
          <ProjectLogo name={p.name} logo={p.logo} accent={p.accent} size="md" />
        </span>
        {p.name}
      </span>
      <h1 class="reveal" style="--d:.05s">{study.data.title}</h1>
      <p class="lead reveal" style="--d:.1s">{p.oneLiner}</p>
      <div class="reveal" style="--d:.15s"><AiRole role={p.aiRole} labels={copy.aiRole} /></div>
    </header>

    <div class="cs-subnav">
      <span class="cs-subnav-name">{p.name}</span>
      <span class="cs-subnav-area">{p.areas.map((area) => copy.areas[area]).join(' · ')}</span>
      <a class="cs-subnav-top" href="#main">{copy.project.top}</a>
    </div>

    {!isShort && study.data.stats.length > 0 && (
      <div class="cs-stats">
        {study.data.stats.map((stat, i) => (
          <div class="cs-stat reveal" style={`--d:${i * 0.07}s`}>
            <b>{stat.value}</b>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    )}

    {p.diagram && (
      <figure class="shot shot-diagram reveal">
        <div class="shot-frame"><Diagram diagram={p.diagram} accent={p.accent} name={p.name} labels={copy.flow} lang={lang} /></div>
      </figure>
    )}

    {/* A diagram already shows the architecture; the flow would repeat it. */}
    {study.data.flow.length > 0 && !p.diagram && <Flow steps={study.data.flow} />}

    <div class="cs-meta reveal">
      <div>
        <span class="eyebrow">{copy.project.area}</span>
        <p>{p.areas.map((area) => copy.areas[area]).join(' · ')}</p>
      </div>
      <div>
        <span class="eyebrow">{copy.project.status}</span>
        <p><span class="status" data-status={p.status}>{copy.status[p.status]}</span></p>
      </div>
      <div>
        <span class="eyebrow">{copy.project.stack}</span>
        <Chips items={p.stack} />
      </div>
    </div>

    {study.data.draft && <p class="draft-banner">{copy.project.draft}</p>}

    {p.underTheHood.length > 0 && (
      <details class="under-block reveal">
        <summary>{copy.project.underTheHood}</summary>
        <ul>{p.underTheHood.map((item) => <li>{item}</li>)}</ul>
      </details>
    )}

    {isShort ? (
      p.diagram ? (
        <StudyBlocks blocks={study.data.blocks} />
      ) : (
        <div class="study-split">
          <div class="study-visual">
            <ProjectPoster id={project.id} name={p.name} logo={p.logo} accent={p.accent} fact={p.fact} />
          </div>
          <StudyBlocks blocks={study.data.blocks} />
        </div>
      )
    ) : (
      <>
        {study.data.decisions.length > 0 && (
          <section class="decisions-wrap">
            <h2 class="cs-band-title">{copy.project.keyDecisions}</h2>
            <DecisionCards items={study.data.decisions} labels={copy.decisions} />
          </section>
        )}
        <div class="cs-layout">
          <CaseRail
            headings={headings}
            nodes={p.diagram && typeof p.diagram === 'object' ? p.diagram.nodes : []}
            labels={copy.rail}
            exclude={copy.project.keyDecisions}
          />
          <article class="prose"><Content /></article>
        </div>
      </>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2 class="cs-band-title">{copy.project.related}</h2>
        <div class="related-grid">
          {related.map(({ entry }) => (
            <a class="related-card" href={path(lang, `/projects/${entry.id}/`)} style={`--accent:${entry.data.accent}`}>
              <ProjectLogo name={entry.data.name} logo={entry.data.logo} accent={entry.data.accent} size="md" />
              <div>
                <h3>{entry.data.name}</h3>
                <p>{entry.data.oneLiner}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {next && next.id !== project.id && (
      <a class="next-cta" href={path(lang, `/projects/${next.id}/`)} style={`--accent:${next.data.accent}`}>
        <div>
          <span class="eyebrow">{copy.project.next}</span>
          <h3>{next.data.name}</h3>
        </div>
        <span class="btn primary">{copy.project.read}</span>
      </a>
    )}
  </div>
</Base>

<script>
  let progressFrame = 0;

  const updateProgress = () => {
    progressFrame = 0;
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    bar.style.transform = `scaleX(${ratio})`;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!progressFrame) progressFrame = requestAnimationFrame(updateProgress);
    },
    { passive: true },
  );

  document.addEventListener('astro:page-load', updateProgress);
  updateProgress();
</script>
