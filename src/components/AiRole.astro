---
import type { UI } from '../data/i18n/ui';

interface Props {
  role: { spec: string; impl: string; audit: string };
  labels: UI['aiRole'];
}

const { role, labels } = Astro.props;
---

<div class="ai-role" aria-label={labels.aria}>
  <span>{labels.spec}: <b>{role.spec}</b></span>
  <span>{labels.impl}: <b>{role.impl}</b></span>
  <span>{labels.audit}: <b>{role.audit}</b></span>
</div>
