---
interface Props {
  name: string;
  logo?: string;
  accent?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, logo, accent = '#7c5cff', size = 'md' } = Astro.props;
const px = size === 'lg' ? 64 : size === 'md' ? 44 : 24;
const initial = name.trim().charAt(0).toUpperCase();
---

{logo ? (
  <img class={`logo logo-${size}`} src={logo} alt="" width={px} height={px} loading="lazy" />
) : (
  <span class={`logo logo-${size} logo-mono`} style={`--mono-accent:${accent}`} aria-hidden="true">{initial}</span>
)}
