---
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

interface KizunaText {
  aria: string;
  headline: string;
  runs: string;
  status: { gate: string; running: string; queued: string };
  nodes: { title: string; sub: string }[];
  agentSession: string;
  gates: { auto: string; human: string };
  parallel: string;
  progress: string;
  queued: string;
  footer: string[];
  caption: string;
}

const TEXTS: Record<Lang, KizunaText> = {
  en: {
    aria: 'Kizuna: three runs in parallel, each a workflow of playbooks and agent sessions with human gates',
    headline: 'Three runs in flight, each on its own workflow.',
    runs: 'RUNS',
    status: { gate: 'at a human gate', running: 'running', queued: 'queued' },
    nodes: [
      { title: 'Plan', sub: 'playbook v3' },
      { title: 'Build', sub: 'playbook v5' },
      { title: 'Review', sub: 'playbook v2' },
      { title: 'Ship', sub: 'pull request' },
    ],
    agentSession: 'agent session',
    gates: { auto: 'auto', human: 'human' },
    parallel: 'IN PARALLEL',
    progress: 'node 2 of 4',
    queued: 'queued',
    footer: ['journal per transition', 'budget per run: tokens · cost · time · steps', 'cooperative cancel', 'immutable graph snapshot'],
    caption: 'a run can wait, retry or stop — the workflow never depends on which agent runtime is behind the port',
  },
  es: {
    aria: 'Kizuna: tres ejecuciones en paralelo, cada una un flujo de playbooks y sesiones de agentes con puertas humanas',
    headline: 'Tres ejecuciones en vuelo, cada una con su flujo.',
    runs: 'EJECUCIONES',
    status: { gate: 'en una puerta humana', running: 'en marcha', queued: 'en cola' },
    nodes: [
      { title: 'Plan', sub: 'playbook v3' },
      { title: 'Construir', sub: 'playbook v5' },
      { title: 'Revisar', sub: 'playbook v2' },
      { title: 'Entregar', sub: 'pull request' },
    ],
    agentSession: 'sesión de agente',
    gates: { auto: 'auto', human: 'humana' },
    parallel: 'EN PARALELO',
    progress: 'nodo 2 de 4',
    queued: 'en cola',
    footer: ['journal por transición', 'presupuesto por ejecución: tokens · coste · tiempo · pasos', 'cancelación cooperativa', 'instantánea inmutable del grafo'],
    caption: 'una ejecución puede esperar, reintentar o pararse: el flujo nunca depende de qué runtime haya detrás del puerto',
  },
};

const T = TEXTS[lang];

// Three runs in flight, one workflow each. The active run is waiting at a human gate
// after its second node; the other two advance in parallel.
const runs = [
  { id: '4f2a', ticket: 'PAY-412 · Jira', status: T.status.gate, tone: 'amber', y: 150 },
  { id: '9c11', ticket: 'PAY-409 · GitHub', status: T.status.running, tone: 'green', y: 226 },
  { id: '7d03', ticket: 'PAY-418 · Jira', status: T.status.queued, tone: 'grey', y: 302 },
];

const nodes = T.nodes.map((node, i) => ({
  ...node,
  state: i < 2 ? 'done' : 'next',
  x: 330 + i * 210,
}));

const gates = [
  { cx: 525, label: T.gates.auto, tone: 'muted' },
  { cx: 735, label: T.gates.human, tone: 'amber' },
  { cx: 945, label: T.gates.auto, tone: 'muted' },
];
---

<svg viewBox="0 0 1200 640" role="img" aria-label={T.aria}>
  <text x="40" y="46" fill="var(--dg-muted)" font-family="ui-monospace, Consolas, monospace" font-size="12" letter-spacing="2.4">KIZUNA · ORCHESTRATOR</text>
  <text x="40" y="82" fill="var(--dg-ink)" font-family="system-ui, Segoe UI, sans-serif" font-size="22" font-weight="700" letter-spacing="-0.4">{T.headline}</text>

  <text x="40" y="132" fill="var(--dg-muted-soft)" font-family="ui-monospace, Consolas, monospace" font-size="10" letter-spacing="1.8">{T.runs}</text>

  <g font-family="system-ui, Segoe UI, sans-serif">
    {runs.map((run) => (
      <g>
        <rect x="40" y={run.y} width="250" height="66" rx="12" fill="var(--dg-card)" stroke="var(--dg-line)" stroke-opacity={run.tone === 'amber' ? '0.9' : '0.6'}/>
        <circle class={`kz-dot ${run.tone}`} cx="62" cy={run.y + 24} r="4"/>
        <text x="78" y={run.y + 28} fill="var(--dg-ink)" font-family="ui-monospace, Consolas, monospace" font-size="12">{run.id}</text>
        <text x="78" y={run.y + 48} fill="var(--dg-muted)" font-family="ui-monospace, Consolas, monospace" font-size="10">{run.ticket}</text>
        <text class={`kz-state ${run.tone}`} x="270" y={run.y + 28} text-anchor="end">{run.status}</text>
      </g>
    ))}
  </g>

  {nodes.map((node, i) => (
    <g>
      <rect x={node.x} y="150" width="180" height="70" rx="12" fill="var(--dg-card)" stroke="var(--dg-line)" stroke-opacity={node.state === 'next' ? '0.5' : '1'}/>
      <text x={node.x + 16} y="180" fill={node.state === 'next' ? 'var(--dg-muted)' : 'var(--dg-ink)'} font-family="system-ui, Segoe UI, sans-serif" font-size="15" font-weight="700">{node.title}</text>
      <text x={node.x + 16} y="202" fill="var(--dg-muted-soft)" font-family="ui-monospace, Consolas, monospace" font-size="10">{node.sub}</text>
      <line x1={node.x + 90} y1="220" x2={node.x + 90} y2="232" stroke="var(--dg-line)"/>
      <rect x={node.x + 20} y="232" width="140" height="26" rx="13" fill="var(--dg-chip)" stroke="var(--dg-line)"/>
      <circle class={`kz-dot ${node.state === 'done' ? 'green' : 'grey'}`} cx={node.x + 36} cy="245" r="3"/>
      <text x={node.x + 46} y="249" fill="var(--dg-muted)" font-family="ui-monospace, Consolas, monospace" font-size="9.5">{T.agentSession}</text>
      {i < nodes.length - 1 && (
        <line x1={node.x + 180} y1="185" x2={node.x + 210} y2="185" stroke="var(--dg-line)"/>
      )}
    </g>
  ))}

  {gates.map((gate) => (
    <g>
      <rect class={`kz-gate ${gate.tone}`} x={gate.cx - 11} y="174" width="22" height="22" rx="3" transform={`rotate(45 ${gate.cx} 185)`}/>
      <text class={`kz-gate-label ${gate.tone}`} x={gate.cx} y="162" text-anchor="middle">{gate.label}</text>
    </g>
  ))}

  <text x="330" y="330" fill="var(--dg-muted-soft)" font-family="ui-monospace, Consolas, monospace" font-size="10" letter-spacing="1.8">{T.parallel}</text>

  <g font-family="ui-monospace, Consolas, monospace" font-size="10">
    <text x="330" y="366" fill="var(--dg-ink-2)">9c11</text>
    <rect x="380" y="357" width="720" height="8" rx="4" fill="var(--dg-tile)"/>
    <rect class="kz-bar" x="380" y="357" width="360" height="8" rx="4" fill="var(--dg-ok)" fill-opacity="0.7"/>
    <text x="1120" y="366" fill="var(--dg-muted-soft)" text-anchor="end">{T.progress}</text>

    <text x="330" y="402" fill="var(--dg-ink-2)">7d03</text>
    <rect x="380" y="393" width="720" height="8" rx="4" fill="var(--dg-tile)"/>
    <text x="1120" y="402" fill="var(--dg-muted-soft)" text-anchor="end">{T.queued}</text>
  </g>

  <rect x="40" y="470" width="1120" height="66" rx="12" fill="var(--dg-panel)" stroke="var(--dg-line)"/>
  <g font-family="ui-monospace, Consolas, monospace" font-size="10.5" fill="var(--dg-muted)">
    <text x="64" y="508">{T.footer[0]}</text>
    <text x="300" y="508">{T.footer[1]}</text>
    <text x="700" y="508">{T.footer[2]}</text>
    <text x="880" y="508">{T.footer[3]}</text>
  </g>

  <text x="40" y="590" fill="var(--dg-muted-soft)" font-family="ui-monospace, Consolas, monospace" font-size="11">{T.caption}</text>
</svg>
