<svg viewBox="0 0 1200 640" role="img" aria-label="Oracle: services report to an agent, a catalogue and a panel, with bounded recovery">
  <image href="/logos/oracle.png" x="60" y="30" width="30" height="30"/>
  <text x="102" y="51" fill="#8b88a3" font-family="ui-monospace, Consolas, monospace" font-size="12" letter-spacing="2.4">ORACLE · SERVICE CONTROL</text>
  <text x="60" y="96" fill="#e9e8f2" font-family="system-ui, Segoe UI, sans-serif" font-size="24" font-weight="700" letter-spacing="-0.5">Status, logs and a restart with limits.</text>

  <g font-family="system-ui, Segoe UI, sans-serif">
    <rect x="60" y="170" width="300" height="52" rx="11" fill="#0d0d18" stroke="#ffffff" stroke-opacity="0.14"/>
    <circle cx="84" cy="196" r="4" fill="#34d399"/>
    <image href="/logos/kizuna.png" x="98" y="184" width="24" height="24"/>
    <text x="134" y="201" fill="#f2f1f7" font-size="14" font-weight="600">kizuna</text>

    <rect x="60" y="230" width="300" height="52" rx="11" fill="#0d0d18" stroke="#ffffff" stroke-opacity="0.14"/>
    <circle cx="84" cy="256" r="4" fill="#34d399"/>
    <image href="/logos/plutus.png" x="98" y="244" width="24" height="24"/>
    <text x="134" y="261" fill="#f2f1f7" font-size="14" font-weight="600">plutus</text>

    <rect x="60" y="290" width="300" height="52" rx="11" fill="#0d0d18" stroke="#fbbf24" stroke-opacity="0.6"/>
    <circle cx="84" cy="316" r="4" fill="#fbbf24"/>
    <image href="/logos/atlas.png" x="98" y="304" width="24" height="24"/>
    <text x="134" y="321" fill="#f2f1f7" font-size="14" font-weight="600">atlas</text>

    <rect x="60" y="350" width="300" height="52" rx="11" fill="#0d0d18" stroke="#ffffff" stroke-opacity="0.14"/>
    <circle cx="84" cy="376" r="4" fill="#34d399"/>
    <image href="/logos/kairos.png" x="98" y="364" width="24" height="24"/>
    <text x="134" y="381" fill="#f2f1f7" font-size="14" font-weight="600">kairos</text>

    <rect x="60" y="410" width="300" height="52" rx="11" fill="#0d0d18" stroke="#ffffff" stroke-opacity="0.14"/>
    <circle cx="84" cy="436" r="4" fill="#34d399"/>
    <image href="/logos/tanko.png" x="98" y="424" width="24" height="24"/>
    <text x="134" y="441" fill="#f2f1f7" font-size="14" font-weight="600">tanko</text>
  </g>

  <line x1="360" y1="316" x2="410" y2="316" stroke="#ffffff" stroke-opacity="0.25" stroke-width="1.5"/>
  <path d="M402 311 L412 316 L402 321" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1.5"/>
  <line x1="630" y1="316" x2="670" y2="316" stroke="#ffffff" stroke-opacity="0.25" stroke-width="1.5"/>
  <path d="M662 311 L672 316 L662 321" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1.5"/>
  <line x1="870" y1="316" x2="910" y2="316" stroke="#ffffff" stroke-opacity="0.25" stroke-width="1.5"/>
  <path d="M902 311 L912 316 L902 321" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1.5"/>

  <g font-family="system-ui, Segoe UI, sans-serif">
    <rect x="420" y="170" width="210" height="292" rx="14" fill="#0b0b14" stroke="#ffffff" stroke-opacity="0.1"/>
    <text x="444" y="206" fill="#38bdf8" font-family="ui-monospace, Consolas, monospace" font-size="11" letter-spacing="1.8">AGENT</text>
    <text x="444" y="234" fill="#b7b5c8" font-size="13">Runs beside each</text>
    <text x="444" y="252" fill="#b7b5c8" font-size="13">service.</text>
    <text x="444" y="292" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">health</text>
    <text x="444" y="316" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">stdout · stderr</text>
    <text x="444" y="340" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">metrics</text>
    <text x="444" y="364" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">deploys</text>

    <rect x="680" y="170" width="190" height="292" rx="14" fill="#0b0b14" stroke="#ffffff" stroke-opacity="0.1"/>
    <text x="704" y="206" fill="#38bdf8" font-family="ui-monospace, Consolas, monospace" font-size="11" letter-spacing="1.8">CATALOGUE</text>
    <text x="704" y="234" fill="#b7b5c8" font-size="13">One row per</text>
    <text x="704" y="252" fill="#b7b5c8" font-size="13">service.</text>
    <text x="704" y="292" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">shared by the</text>
    <text x="704" y="310" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">agent and</text>
    <text x="704" y="328" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">the panel</text>

    <rect x="920" y="170" width="220" height="292" rx="14" fill="#0b0b14" stroke="#ffffff" stroke-opacity="0.1"/>
    <text x="944" y="206" fill="#38bdf8" font-family="ui-monospace, Consolas, monospace" font-size="11" letter-spacing="1.8">PANEL</text>
    <text x="944" y="234" fill="#b7b5c8" font-size="13">Tray app and</text>
    <text x="944" y="252" fill="#b7b5c8" font-size="13">React view.</text>
    <text x="944" y="292" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">status</text>
    <text x="944" y="316" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">restart history</text>
    <text x="944" y="340" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">deploy trigger</text>
  </g>

  <rect x="60" y="500" width="1080" height="84" rx="14" fill="#0b0b14" stroke="#ffffff" stroke-opacity="0.1"/>
  <text x="84" y="528" fill="#8b88a3" font-family="ui-monospace, Consolas, monospace" font-size="11" letter-spacing="1.8">BOUNDED RECOVERY · ADR 0007</text>

  <g font-family="ui-monospace, Consolas, monospace" font-size="10.5" fill="#b7b5c8">
    <rect x="84" y="544" width="104" height="30" rx="8" fill="#12121c" stroke="#ffffff" stroke-opacity="0.14"/>
    <text x="100" y="563">detect</text>
    <text x="198" y="563" fill="#6f6c85">›</text>
    <rect x="216" y="544" width="170" height="30" rx="8" fill="#12121c" stroke="#ffffff" stroke-opacity="0.14"/>
    <text x="232" y="563">dependencies up?</text>
    <text x="396" y="563" fill="#6f6c85">›</text>
    <rect x="414" y="544" width="104" height="30" rx="8" fill="#12121c" stroke="#ffffff" stroke-opacity="0.14"/>
    <text x="430" y="563">restart</text>
    <text x="528" y="563" fill="#6f6c85">›</text>
    <rect x="546" y="544" width="118" height="30" rx="8" fill="#12121c" stroke="#ffffff" stroke-opacity="0.14"/>
    <text x="562" y="563">cooldown</text>
    <text x="674" y="563" fill="#6f6c85">›</text>
    <rect x="692" y="544" width="110" height="30" rx="8" fill="#1a1408" stroke="#fbbf24" stroke-opacity="0.55"/>
    <text x="708" y="563" fill="#fbbf24">give up</text>
  </g>
  <text x="830" y="563" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">window · attempts · cooldown</text>

  <text x="60" y="620" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="11">a service that keeps dying needs a person, not a faster loop</text>
</svg>
