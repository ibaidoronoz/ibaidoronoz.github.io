  <text x="960" y="222" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">each one</text>
  <text x="960" y="240" fill="#b7b5c8" font-family="system-ui, Segoe UI, sans-serif" font-size="12">starts from the same</text>
  <text x="960" y="258" fill="#b7b5c8" font-family="system-ui, Segoe UI, sans-serif" font-size="12">tested context,</text>
  <text x="960" y="276" fill="#b7b5c8" font-family="system-ui, Segoe UI, sans-serif" font-size="12">never a copied prompt.</text>

