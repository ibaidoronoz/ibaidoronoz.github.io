<svg viewBox="0 0 1200 730" role="img" aria-label="Engineering platform: Prometheus, Torii, Kagi and Festive shared by twenty repositories">
  <text x="60" y="58" fill="#8b88a3" font-family="ui-monospace, Consolas, monospace" font-size="12" letter-spacing="2.4">ENGINEERING PLATFORM</text>
  <text x="60" y="96" fill="#e9e8f2" font-family="system-ui, Segoe UI, sans-serif" font-size="24" font-weight="700" letter-spacing="-0.5">Four layers every repository shares.</text>

  <g font-family="system-ui, Segoe UI, sans-serif">
    <rect x="60" y="150" width="420" height="104" rx="14" fill="#0d0d18" stroke="#8b5cf6" stroke-opacity="0.7"/>
    <image href="/logos/prometheus.png" x="84" y="172" width="26" height="26"/>
    <text x="122" y="186" fill="#f2f1f7" font-size="18" font-weight="700">Prometheus</text>
    <text x="122" y="206" fill="#8b88a3" font-family="ui-monospace, Consolas, monospace" font-size="11">shared AI context</text>
    <text x="84" y="234" fill="#b7b5c8" font-size="13">Skills, agents, flows and playbooks.</text>

    <rect x="60" y="280" width="420" height="104" rx="14" fill="#0d0d18" stroke="#22d3ee" stroke-opacity="0.55"/>
    <image href="/logos/torii.png" x="84" y="302" width="26" height="26"/>
    <text x="122" y="316" fill="#f2f1f7" font-size="18" font-weight="700">Torii</text>
    <text x="122" y="336" fill="#8b88a3" font-family="ui-monospace, Consolas, monospace" font-size="11">one gateway</text>
    <text x="84" y="364" fill="#b7b5c8" font-size="13">Routes every service by hostname and path.</text>

    <rect x="60" y="410" width="420" height="104" rx="14" fill="#0d0d18" stroke="#ff8a00" stroke-opacity="0.7"/>
    <image href="/logos/kagi.png" x="84" y="432" width="26" height="26"/>
    <text x="122" y="446" fill="#f2f1f7" font-size="18" font-weight="700">Kagi</text>
    <text x="122" y="466" fill="#8b88a3" font-family="ui-monospace, Consolas, monospace" font-size="11">single sign-on</text>
    <text x="84" y="494" fill="#b7b5c8" font-size="13">One login in front of every route; identity signed.</text>

    <rect x="60" y="540" width="420" height="104" rx="14" fill="#0d0d18" stroke="#e04fb8" stroke-opacity="0.55"/>
    <image href="/logos/festive.png" x="84" y="562" width="26" height="26"/>
    <text x="122" y="576" fill="#f2f1f7" font-size="18" font-weight="700">Festive</text>
    <text x="122" y="596" fill="#8b88a3" font-family="ui-monospace, Consolas, monospace" font-size="11">shared UI engine</text>
    <text x="84" y="624" fill="#b7b5c8" font-size="13">Vendored into each app, with a drift check.</text>
  </g>

  <line x1="480" y1="397" x2="690" y2="397" stroke="#ffffff" stroke-opacity="0.25" stroke-width="1.5"/>
  <path d="M682 392 L692 397 L682 402" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1.5"/>
  <text x="486" y="386" fill="#6f6c85" font-family="ui-monospace, Consolas, monospace" font-size="10.5">used by every repository</text>

