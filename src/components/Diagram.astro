---
import KizunaDiagram from './diagrams/Kizuna.astro';
import PlatformDiagram from './diagrams/Platform.astro';
import OracleDiagram from './diagrams/Oracle.astro';
import FlowDiagram from './FlowDiagram.astro';
import type { UI } from '../data/i18n/ui';
import type { Lang } from '../lib/i18n';

interface DiagramSpec {
  kind: 'flow' | 'fork' | 'layers' | 'loop';
  nodes: { title: string; sub: string }[];
  highlight?: number;
}

interface Props {
  diagram: string | DiagramSpec;
  accent: string;
  name: string;
  labels?: UI['flow'];
  lang?: Lang;
}

const { diagram, accent, name, labels, lang = 'en' } = Astro.props;
const named: Record<string, typeof KizunaDiagram> = {
  kizuna: KizunaDiagram,
  'engineering-platform': PlatformDiagram,
  oracle: OracleDiagram,
};
const Component = typeof diagram === 'string' ? named[diagram] : null;
if (typeof diagram === 'string' && !Component) throw new Error(`Unknown diagram: ${diagram}`);
---

{Component ? (
  <Component lang={lang} />
) : (
  <FlowDiagram
    kind={(diagram as DiagramSpec).kind}
    nodes={(diagram as DiagramSpec).nodes}
    highlight={(diagram as DiagramSpec).highlight}
    accent={accent}
    name={name}
    labels={labels}
  />
)}
